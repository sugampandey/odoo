<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="swagger_docyt_template">
        <html>
            <head>
                <title>General Ledger API Documentation (Demo)</title>
                <link rel="stylesheet" type="text/css" href="https://unpkg.com/swagger-ui-dist@3/swagger-ui.css" />
                <style>
                    body {
                        margin: 0;
                        padding: 0;
                    }
                    #swagger-ui {
                        max-width: 1460px;
                        margin: 0 auto;
                        padding: 20px;
                    }
                    .demo-banner {
                        background-color: #f8d7da;
                        color: #721c24;
                        padding: 10px 15px;
                        margin-bottom: 20px;
                        border: 1px solid #f5c6cb;
                        border-radius: 4px;
                        font-weight: bold;
                        text-align: center;
                    }
                    /* Hide the "Try it out" buttons */
                    .try-out, .try-out__btn {
                        display: none !important;
                    }
                    /* Hide the schemas section */
                    .swagger-ui .models {
                        display: none !important;
                    }
                </style>
            </head>
            <body>
                <div class="demo-banner">
                    This is a demo view of the General Ledger API. API calls are disabled in this view.
                </div>
                <div id="swagger-ui"></div>
                <script src="https://unpkg.com/swagger-ui-dist@3/swagger-ui-bundle.js"></script>
                <script>
                    window.onload = function() {
                        SwaggerUIBundle({
                            spec: <t t-raw="spec"/>,
                            dom_id: '#swagger-ui',
                            supportedSubmitMethods: [], // Disable all HTTP methods
                            docExpansion: 'list',
                            deepLinking: true,
                            filter: true,
                            presets: [
                                SwaggerUIBundle.presets.apis
                            ],
                            plugins: [
                                SwaggerUIBundle.plugins.DownloadUrl
                            ],
                            layout: "BaseLayout",
                            onComplete: function() {
                                // Additional script to hide schema models
                                var models = document.querySelector('.swagger-ui .models');
                                if (models) {
                                    models.style.display = 'none';
                                }
                            }
                        });
                    }
                </script>
            </body>
        </html>
    </template>
    
    <!-- Error template for handling exceptions -->
    <template id="error_template">
        <html>
            <head>
                <title>Error</title>
                <style>
                    body {
                        font-family: Arial, sans-serif;
                        margin: 0;
                        padding: 20px;
                        background-color: #f8f9fa;
                    }
                    .error-container {
                        max-width: 800px;
                        margin: 50px auto;
                        padding: 20px;
                        background-color: #fff;
                        border-radius: 5px;
                        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
                    }
                    h1 {
                        color: #dc3545;
                    }
                    .error-message {
                        padding: 15px;
                        background-color: #f8d7da;
                        border: 1px solid #f5c6cb;
                        border-radius: 4px;
                        color: #721c24;
                        margin-top: 20px;
                    }
                </style>
            </head>
            <body>
                <div class="error-container">
                    <h1>Error</h1>
                    <p>An error occurred while generating the API documentation:</p>
                    <div class="error-message">
                        <t t-esc="error"/>
                    </div>
                </div>
            </body>
        </html>
    </template>
</odoo>
